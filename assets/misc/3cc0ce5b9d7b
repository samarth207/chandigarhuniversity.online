 					duration: 10,
 					start: function() {
 						$accordionContent.height($accordionContent.outerHeight());
 					},
 					step: function(now, fx) {
 						if (fx.prop == 'height') {
 							$accordionContent.height($accordionContent.outerHeight() - fx.start + fx.now);
